# Local MongoDB (for day-to-day development)
MONGODB_URI=mongodb://localhost:27017/yogitrack

# Or MongoDB Atlas (what production/Heroku uses)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/yogitrack?retryWrites=true&w=majority

PORT=5000
NODE_ENV=development

# Optional: gates the whole app behind an HTTP Basic Auth prompt when both are set.
# Leave unset for local dev; set these on Heroku so only credentialed reviewers can access it.
# APP_USERNAME=
# APP_PASSWORD=
